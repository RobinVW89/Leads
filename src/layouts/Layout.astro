---
import { SITE_CONFIG } from '../config/site';
import BrandMark from '../components/BrandMark.astro';
import BandeauCookies from '../components/BandeauCookies.astro';
import '../styles/theme.css';

type Crumb = {
	label: string;
	href?: string;
};

type Props = {
	title: string;
	description: string;
	canonicalPath?: string;
	breadcrumbs?: Crumb[];
	jsonLd?: object | object[];
	noindex?: boolean;
	stickyCta?: {
		label: string;
		href: string;
		badge?: string;
	};
};

const {
	title,
	description,
	canonicalPath = Astro.url.pathname,
	breadcrumbs = [],
	jsonLd = [],
	noindex = false,
	stickyCta
} = Astro.props;
// Le serveur redirige toute URL sans slash final (308) : la canonique doit pointer
// directement sur l'URL finale, sinon le signal passe par une redirection.
const normalizedPath = canonicalPath.endsWith('/') ? canonicalPath : `${canonicalPath}/`;
const canonicalUrl = new URL(normalizedPath, SITE_CONFIG.siteUrl).toString();
const jsonLdList = Array.isArray(jsonLd) ? jsonLd : [jsonLd];
const ogImageUrl = new URL('/images/og-lesprosdelyonne.jpg', SITE_CONFIG.siteUrl).toString();

// JSON.stringify n'échappe pas « </script> » : une donnée contenant cette
// séquence sortirait du bloc. On neutralise « < » en échappement unicode,
// ce que tout analyseur JSON comprend.
const enJsonSur = (valeur: object) => JSON.stringify(valeur).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		{noindex && <meta name="robots" content="noindex, follow" />}
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="fr_FR" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:site_name" content={SITE_CONFIG.siteName} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:alt" content="Travaux & Pros de l'Yonne : vos travaux, les bons pros près de chez vous. Yonne 89." />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="theme-color" content="#123d2c" />
		<link rel="preload" href="/fonts/space-grotesk-700.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/source-sans-3-400.woff2" as="font" type="font/woff2" crossorigin />
		<!-- Google Analytics n'est PAS chargé ici : il ne l'est qu'après
		     acceptation explicite, par le bandeau de consentement. -->
		{jsonLdList.map((entry) => (
			<script is:inline type="application/ld+json" set:html={enJsonSur(entry)} />
		))}
	</head>
	<body>
		<a href="#contenu" class="skip-link">Aller au contenu principal</a>
		<header class="site-header">
			<div class="container inner">
				<a class="brand" href="/">
					<BrandMark />
					<span class="brand-text">
						{SITE_CONFIG.siteName}
						<small>Yonne · 89</small>
					</span>
				</a>
				<nav class="top-nav" id="top-nav" aria-label="Navigation principale">
					<a href="/#metiers">Métiers</a>
					<a href="/#villes">Villes</a>
					<a href="/comment-ca-marche">Comment ça marche</a>
					<a href="/espace-pro/">Espace pro</a>
					<a href="/politique-confidentialite">Confidentialité</a>
					<a href="/mentions-legales">Mentions légales</a>
				</nav>
				<div class="header-actions">
					<a class="tel-link" href={`tel:${SITE_CONFIG.telContactHref}`}>
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M6.2 3.5h3l1.4 3.6-2 1.4a11 11 0 0 0 5 5l1.4-2 3.6 1.4v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.2 5.7a2 2 0 0 1 2-2.2Z" />
						</svg>
						<span class="tel-text">{SITE_CONFIG.telContact}</span>
						<span class="sr-only">Appeler le {SITE_CONFIG.telContact}</span>
					</a>
					<button
						type="button"
						class="nav-toggle"
						id="nav-toggle"
						aria-controls="top-nav"
						aria-expanded="false"
						aria-label="Ouvrir le menu de navigation"
					>
						<svg class="icon-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
							<path d="M4 7h16M4 12h16M4 17h16" />
						</svg>
						<svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
							<path d="M6 6l12 12M18 6 6 18" />
						</svg>
					</button>
				</div>
			</div>
		</header>
		<main class="container" id="contenu">
			{breadcrumbs.length > 0 && (
				<nav class="breadcrumbs" aria-label="Fil d'Ariane">
					{breadcrumbs.map((crumb, index) => (
						<>
							{index > 0 && ' / '}
							{crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span>{crumb.label}</span>}
						</>
					))}
				</nav>
			)}
			<slot />
		</main>
		<footer class="footer">
			<div class="container">
				<div class="footer-grid">
					<div>
						<a class="footer-brand" href="/">
							<BrandMark />
							<span>{SITE_CONFIG.siteName}</span>
						</a>
						<p>
							{SITE_CONFIG.siteName} • Mise en relation gratuite avec des professionnels locaux vérifiés dans
							l'Yonne.
						</p>
						<p>
							<a class="tel-link" href={`tel:${SITE_CONFIG.telContactHref}`}>
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M6.2 3.5h3l1.4 3.6-2 1.4a11 11 0 0 0 5 5l1.4-2 3.6 1.4v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.2 5.7a2 2 0 0 1 2-2.2Z" />
								</svg>
								<span>{SITE_CONFIG.telContact}</span>
							</a>
						</p>
					</div>
					<div>
						<p class="footer-column-title">Nos pros à Auxerre</p>
						<p class="footer-links">
							<a href="/auxerre/">Hub Auxerre</a>
							<a href="/plombier-chauffagiste/auxerre/">Plombier</a>
							<a href="/climatisation-pompe-a-chaleur/auxerre/">Climatisation</a>
							<a href="/electricien/auxerre/">Électricien</a>
							<a href="/couvreur/auxerre/">Couvreur</a>
							<a href="/menuisier-portail-fenetre/auxerre/">Menuisier</a>
							<a href="/isolation/auxerre/">Isolation</a>
							<a href="/estimation-immobiliere/auxerre/">Estimation</a>
							<a href="/courtier-credit-assurance/auxerre/">Courtier</a>
						</p>
					</div>
					<div>
						<p class="footer-column-title">Espace pro</p>
						<p>
							<a href="/espace-pro/">Vous êtes artisan ? Rejoignez le site</a>
						</p>
						<p class="footer-column-title" style="margin-top: 1.3rem;">Villes couvertes</p>
						<p class="footer-links">
							<a href="/auxerre/">Auxerre</a>
							<a href="/sens/">Sens</a>
							<a href="/joigny/">Joigny</a>
						</p>
					</div>
				</div>
				<div class="footer-bottom">
					<p>
						<a href="/comment-ca-marche">Comment ça marche</a> • <a href="/mentions-legales">Mentions légales</a>{' '}
						• <a href="/politique-confidentialite">Politique de confidentialité</a>{' '}
						• <a href="#" data-gerer-cookies>Gérer mes cookies</a>
					</p>
					<p>Réseau local de l'Yonne (89) • Réponse sous 24 h</p>
				</div>
			</div>
		</footer>
		<BandeauCookies />
		{stickyCta && (
			<div class="mobile-sticky-cta" role="region" aria-label="Action rapide">
				{stickyCta.badge && <span>{stickyCta.badge}</span>}
				<a class="btn" href={stickyCta.href}>{stickyCta.label}</a>
			</div>
		)}
		<script is:inline>
			const navToggle = document.getElementById('nav-toggle');
			const topNav = document.getElementById('top-nav');

			if (navToggle instanceof HTMLButtonElement && topNav instanceof HTMLElement) {
				const closeNav = () => {
					topNav.classList.remove('is-open');
					navToggle.setAttribute('aria-expanded', 'false');
					navToggle.setAttribute('aria-label', 'Ouvrir le menu de navigation');
				};

				navToggle.addEventListener('click', () => {
					const isOpen = topNav.classList.toggle('is-open');
					navToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
					navToggle.setAttribute('aria-label', isOpen ? 'Fermer le menu de navigation' : 'Ouvrir le menu de navigation');
				});

				topNav.addEventListener('click', (event) => {
					if (event.target instanceof HTMLAnchorElement) {
						closeNav();
					}
				});

				document.addEventListener('keydown', (event) => {
					if (event.key === 'Escape' && topNav.classList.contains('is-open')) {
						closeNav();
						navToggle.focus();
					}
				});

				document.addEventListener('click', (event) => {
					if (!topNav.classList.contains('is-open')) {
						return;
					}
					if (event.target instanceof Node && !topNav.contains(event.target) && !navToggle.contains(event.target)) {
						closeNav();
					}
				});
			}
		</script>
	</body>
</html>
