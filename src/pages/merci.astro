---
import Layout from '../layouts/Layout.astro';
import BoutonUrgence from '../components/BoutonUrgence.astro';
import { SITE_CONFIG } from '../config/site';
import { metiersData } from '../lib/data';

const title = 'Merci pour votre demande | Travaux & Pros de l\'Yonne';
const description = 'Votre demande a bien été envoyée. Un professionnel local vous recontacte rapidement.';
const breadcrumbs = [
  { label: 'Accueil', href: '/' },
  { label: 'Merci' }
];

const type = Astro.url.searchParams.get('type') || 'lead';
const metier = Astro.url.searchParams.get('metier') || '';
const ville = Astro.url.searchParams.get('ville') || '';

const isIntention = type === 'intention';
const heading = isIntention ? 'Merci, vous êtes inscrit' : 'Merci, votre demande est envoyée';
const message = isIntention
  ? 'Nous vous préviendrons en priorité dès que ce service sera ouvert dans votre secteur.'
  : 'Un professionnel local vous rappelle sous 24 h pour échanger sur votre projet.';

const context = [metier, ville].filter(Boolean).join(' - ');

// La page est prérendue : les paramètres d'URL ne sont pas connus au build.
// Le script ci-dessous réaligne le texte sur l'URL réelle côté navigateur.
const metierNoms = Object.fromEntries(metiersData.map((item) => [item.slug, item.nom]));
---

<Layout title={title} description={description} breadcrumbs={breadcrumbs} canonicalPath="/merci/" noindex>
  <section class="section">
    <h1 class="page-title" id="merci-titre">{heading}</h1>
    <p class="muted" id="merci-message">{message}</p>

    <p class="inline-note" id="merci-contexte" hidden={!context}>
      Demande concernée : <span id="merci-contexte-valeur">{context}</span>
    </p>

    <div class="card" style="margin-top: 1.4rem;">
      <h2>Et maintenant ?</h2>
      <p>
        Vérifiez que votre téléphone est joignable. Si besoin, vous pouvez aussi revenir à l'accueil pour faire une
        nouvelle demande.
      </p>
      <div class="hero-actions">
        <a class="btn" href="/">Retour à l'accueil</a>
        <BoutonUrgence />
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ metierNoms }}>
    const params = new URLSearchParams(window.location.search);
    const type = params.get('type') || 'lead';
    const metierSlug = params.get('metier') || '';
    const ville = params.get('ville') || '';
    const isIntention = type === 'intention';

    const titre = document.getElementById('merci-titre');
    const message = document.getElementById('merci-message');
    const contexte = document.getElementById('merci-contexte');
    const contexteValeur = document.getElementById('merci-contexte-valeur');

    if (titre) {
      titre.textContent = isIntention ? 'Merci, vous êtes inscrit' : 'Merci, votre demande est envoyée';
    }

    if (message) {
      message.textContent = isIntention
        ? 'Nous vous préviendrons en priorité dès que ce service sera ouvert dans votre secteur.'
        : 'Un professionnel local vous rappelle sous 24 h pour échanger sur votre projet.';
    }

    const metierNom = metierNoms[metierSlug] || metierSlug;
    const parts = [metierNom, ville].filter(Boolean);

    if (contexte && contexteValeur) {
      if (parts.length > 0) {
        contexteValeur.textContent = parts.join(' • ');
        contexte.hidden = false;
      } else {
        contexte.hidden = true;
      }
    }
  </script>
</Layout>
