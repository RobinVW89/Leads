---
type Props = {
  certifications?: string[];
};

const { certifications = [] } = Astro.props;
const rgeCertifications = certifications.filter((certification) => certification.startsWith('RGE'));
---

{rgeCertifications.length > 0 && (
  <div class="certification-block" aria-label="Certification partenaire">
    {rgeCertifications.map((certification) => (
      <span class="badge">Professionnels partenaires certifiés {certification}</span>
    ))}
    <p class="muted">
      Cette certification vérifiée conditionne l'accès à plusieurs aides à la rénovation énergétique, comme
      MaPrimeRénov' et les certificats d'économies d'énergie, ainsi qu'à la TVA réduite sur les travaux éligibles.
    </p>
  </div>
)}
