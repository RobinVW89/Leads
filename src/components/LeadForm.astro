---
import { SITE_CONFIG } from '../config/site';
import { getFormulaireConfig, getParcoursByMetierSlug, type ParcoursEtape } from '../lib/data';

type Props = {
  metier: string;
  metierNom?: string;
  ville?: string;
  actif?: boolean;
};

const { metier, metierNom = metier, ville = '', actif = true } = Astro.props;
const formId = `lead-form-${metier}-${ville || 'global'}`;
const parcours = actif ? getParcoursByMetierSlug(metier) : undefined;
const fallbackEtapes: ParcoursEtape[] = [
  {
    question: 'Quel type de travaux souhaitez-vous réaliser ?',
    options: ['Rénovation', 'Dépannage', 'Installation', 'Entretien', 'Autre']
  },
  {
    question: 'Où se situe votre projet ?',
    options: ['Résidence principale', 'Résidence secondaire', 'Local professionnel']
  }
];
const qualificationEtapes = actif
  ? parcours?.etapes && parcours.etapes.length > 0
    ? parcours.etapes
    : fallbackEtapes
  : [];
const totalWizardSteps = qualificationEtapes.length + 2;
const champs = getFormulaireConfig(metier);
// Clé publique du widget anti-robot (destinée au HTML, ce n'est pas un secret).
const turnstileSiteKey = SITE_CONFIG.turnstileSiteKey;
---

<div class="card" id={`${formId}-wrapper`}>
  {actif ? <h2>Démarrer ma demande</h2> : <h2>Service bientôt disponible</h2>}
  {
    actif ? (
      <p class="muted">{champs.intro}</p>
    ) : (
      <p class="muted">
        Ce service ouvre bientôt dans l'Yonne. Laissez votre email pour être prévenu en premier.
      </p>
    )
  }

  <form id={formId} novalidate>
    {actif ? (
      <>
        <div class="lead-progress" role="status" aria-live="polite">
          <p class="lead-progress-text">Question 1</p>
          <div class="lead-progress-track" aria-hidden="true">
            <span class="lead-progress-bar" style="--progress: 0.12;"></span>
          </div>
        </div>

        {qualificationEtapes.map((etape, index) => {
          const stepNumber = index + 1;
          const fieldName = `q_${stepNumber}`;

          return (
            <section class={`lead-step ${stepNumber === 1 ? 'is-active' : ''}`} data-step={stepNumber} hidden={stepNumber !== 1}>
              <fieldset class="lead-options" data-required={etape.facultatif ? 'false' : 'true'} data-field-name={fieldName}>
                <legend>
                  {etape.question} {etape.facultatif && <span class="muted">(facultatif)</span>}
                </legend>
                <div class="lead-options-grid">
                  {etape.options.map((option, optionIndex) => (
                    <label class="lead-option">
                      <input
                        type="radio"
                        name={fieldName}
                        value={option}
                        required={!etape.facultatif && optionIndex === 0}
                        aria-required={!etape.facultatif}
                      />
                      <span>{option}</span>
                    </label>
                  ))}
                </div>
              </fieldset>
            </section>
          );
        })}

        <section class="lead-step" data-step={qualificationEtapes.length + 1} hidden>
          <div>
            <label for={`${formId}-description`}>{champs.descriptionLabel}</label>
            <textarea id={`${formId}-description`} name="description" rows={4} placeholder={champs.descriptionPlaceholder}></textarea>
          </div>

          <div>
            <label for={`${formId}-delai`}>{champs.delaiLabel} *</label>
            <select id={`${formId}-delai`} name="delaiSouhaite" required>
              <option value="">{champs.delaiPlaceholder}</option>
              {champs.delaiOptions.map((option) => (
                <option value={option.value}>{option.label}</option>
              ))}
            </select>
          </div>

          {champs.budget && (
            <div>
              <label for={`${formId}-budget`}>{champs.budgetLabel}</label>
              <select id={`${formId}-budget`} name="budget">
                <option value="">Je ne sais pas encore</option>
                {champs.budgetOptions.map((option) => (
                  <option value={option.value}>{option.label}</option>
                ))}
              </select>
            </div>
          )}
        </section>

        <section class="lead-step" data-step={qualificationEtapes.length + 2} hidden>
          <div class="grid cols-2">
            <div>
              <label for={`${formId}-prenom`}>Prénom *</label>
              <input id={`${formId}-prenom`} name="prenom" autocomplete="given-name" required />
            </div>

            <div>
              <label for={`${formId}-nom`}>Nom *</label>
              <input id={`${formId}-nom`} name="nom" autocomplete="family-name" required />
            </div>
          </div>

          <div class="grid cols-2">
            <div>
              <label for={`${formId}-telephone`}>Téléphone portable *</label>
              <input id={`${formId}-telephone`} name="telephone" autocomplete="tel" inputmode="tel" required />
            </div>

            <div>
              <label for={`${formId}-email`}>Email *</label>
              <input id={`${formId}-email`} name="email" autocomplete="email" type="email" required />
            </div>
          </div>

          <div class="grid cols-2">
            <div>
              <label for={`${formId}-commune`}>Ville *</label>
              <input id={`${formId}-commune`} name="commune" value={ville} required />
            </div>

            <div>
              <label for={`${formId}-codePostal`}>Code postal *</label>
              <input id={`${formId}-codePostal`} name="codePostal" autocomplete="postal-code" inputmode="numeric" required />
            </div>
          </div>
        </section>

        <div class="lead-nav">
          <button type="button" class="btn-ghost" data-action="prev" disabled>Retour</button>
          <button type="button" data-action="next">Suivant</button>
          <button type="submit" data-action="submit" hidden>Envoyer ma demande</button>
        </div>

        <div>
          <label style="display: flex; gap: 0.65rem; align-items: flex-start;">
            <input
              type="checkbox"
              name="consentementDonnees"
              required
              autocomplete="off"
              style="margin-top: 0.2rem;"
            />
            <span>
              J'accepte que mes coordonnées et les informations relatives à ma demande soient
              transmises à un professionnel référencé correspondant au métier et à la zone
              sélectionnés, afin qu'il puisse me contacter.{' '}
              <a href="/politique-confidentialite">Politique de confidentialité</a>.
            </span>
          </label>
        </div>

        <span class="inline-note">Réponse sous 24 h</span>

        <input type="hidden" name="qualification" />

        {/* Turnstile invisible : pose un champ caché cf-turnstile-response.
            Le script n'est chargé que si la clé publique est configurée. */}
        {turnstileSiteKey && (
          <div
            class="cf-turnstile"
            data-sitekey={turnstileSiteKey}
            data-action="lead-form"
            data-size="invisible"
            data-appearance="interaction-only"
          />
        )}
      </>
    ) : (
      <>
        <div>
          <label for={`${formId}-email`}>Email *</label>
          <input id={`${formId}-email`} name="email" autocomplete="email" type="email" required />
        </div>
        <div>
          <label for={`${formId}-commune`}>Commune (facultatif)</label>
          <input id={`${formId}-commune`} name="commune" value={ville} />
        </div>
        <div>
          <label style="display: flex; gap: 0.65rem; align-items: flex-start;">
            <input
              type="checkbox"
              name="consentementDonnees"
              required
              autocomplete="off"
              style="margin-top: 0.2rem;"
            />
            <span>
              J'accepte que mes coordonnées et les informations relatives à ma demande soient
              transmises à un professionnel référencé correspondant au métier et à la zone
              sélectionnés, afin qu'il puisse me contacter.{' '}
              <a href="/politique-confidentialite">Politique de confidentialité</a>.
            </span>
          </label>
        </div>
      </>
    )}

    <input type="hidden" name="metier" value={metier} />
    <input type="hidden" name="metier_nom" value={metierNom} />
    <input type="hidden" name="ville" value={ville} />
    <input type="hidden" name="type" value={actif ? 'lead' : 'intention'} />
    <input type="hidden" name="page_source" />
    <input type="hidden" name="startedAt" />

    <div style="position: absolute; left: -9999px; opacity: 0; pointer-events: none;" aria-hidden="true">
      <label for={`${formId}-website`}>Ne pas remplir</label>
      <input id={`${formId}-website`} name="website" tabindex="-1" autocomplete="off" />
    </div>

    {
      !actif && (
        <>
          <div style="display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center;">
            <button type="submit">Me prévenir à l'ouverture</button>
          </div>        </>
      )
    }
  </form>

  <div id={`${formId}-message`} aria-live="polite" style="margin-top: 0.8rem;"></div>
</div>

{turnstileSiteKey && (
  <script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>
)}

<script
  is:inline
  define:vars={{
    formId,
    endpointUrl: '/api/lead',
    telContact: SITE_CONFIG.telContact,
    actif,
    totalWizardSteps
  }}
>
  // @ts-ignore - Variables injected by define:vars
  const form = document.getElementById(formId);
  // @ts-ignore - Variables injected by define:vars
  const messageBox = document.getElementById(`${formId}-message`);

  if (form instanceof HTMLFormElement && messageBox) {
    const startedAtInput = form.elements.namedItem('startedAt');
    const pageSourceInput = form.elements.namedItem('page_source');

    if (startedAtInput instanceof HTMLInputElement) {
      startedAtInput.value = String(Date.now());
    }
    if (pageSourceInput instanceof HTMLInputElement) {
      pageSourceInput.value = window.location.href;
    }

    const wizardSteps = actif ? Array.from(form.querySelectorAll('.lead-step')) : [];
    const prevButton = form.querySelector('[data-action="prev"]');
    const nextButton = form.querySelector('[data-action="next"]');
    const submitButton = form.querySelector('[data-action="submit"]');
    const progressText = form.querySelector('.lead-progress-text');
    const progressBar = form.querySelector('.lead-progress-bar');
    let currentStepIndex = 0;

    const getRequiredRadioGroups = (step) => {
      if (!(step instanceof HTMLElement)) {
        return [];
      }

      return Array.from(step.querySelectorAll('fieldset[data-required="true"]'));
    };

    const validateCurrentStep = () => {
      if (!actif || wizardSteps.length === 0) {
        return true;
      }

      const step = wizardSteps[currentStepIndex];
      if (!(step instanceof HTMLElement)) {
        return true;
      }

      const requiredFields = Array.from(
        step.querySelectorAll('input[required]:not([type="radio"]), textarea[required], select[required]')
      );

      for (const field of requiredFields) {
        if (
          (field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement || field instanceof HTMLSelectElement) &&
          !field.value.trim()
        ) {
          field.focus();
          field.reportValidity();
          return false;
        }
      }

      const requiredGroups = getRequiredRadioGroups(step);
      for (const group of requiredGroups) {
        const fieldName = group.getAttribute('data-field-name');
        if (!fieldName) {
          continue;
        }

        const checked = form.querySelector(`input[name="${fieldName}"]:checked`);
        if (!checked) {
          const firstInput = group.querySelector('input[type="radio"]');
          if (firstInput instanceof HTMLInputElement) {
            firstInput.focus();
          }
          messageBox.className = 'error';
          messageBox.textContent = 'Veuillez répondre à la question avant de continuer.';
          return false;
        }
      }

      messageBox.className = '';
      messageBox.textContent = '';
      return true;
    };

    const refreshWizardUi = () => {
      if (!actif || wizardSteps.length === 0) {
        return;
      }

      wizardSteps.forEach((step, index) => {
        const isActive = index === currentStepIndex;
        if (step instanceof HTMLElement) {
          step.hidden = !isActive;
          step.classList.toggle('is-active', isActive);
        }
      });

      const currentHumanIndex = currentStepIndex + 1;
      const progress = currentHumanIndex / Math.max(totalWizardSteps, 1);
      const isLast = currentStepIndex === wizardSteps.length - 1;
      const isBeforeLast = currentStepIndex === wizardSteps.length - 2;

      if (progressText instanceof HTMLElement) {
        if (isLast) {
          progressText.textContent = 'Dernière étape : vos coordonnées';
        } else if (isBeforeLast) {
          progressText.textContent = 'Presque terminé';
        } else {
          progressText.textContent = `Question ${currentHumanIndex}`;
        }
      }

      if (progressBar instanceof HTMLElement) {
        progressBar.style.setProperty('--progress', String(progress));
      }

      if (prevButton instanceof HTMLButtonElement) {
        prevButton.disabled = currentStepIndex === 0;
      }

      if (nextButton instanceof HTMLButtonElement) {
        nextButton.hidden = isLast;
      }
      if (submitButton instanceof HTMLButtonElement) {
        submitButton.hidden = !isLast;
      }
    };

    if (actif && wizardSteps.length > 0) {
      refreshWizardUi();

      wizardSteps.forEach((step, stepIndex) => {
        if (!(step instanceof HTMLElement)) {
          return;
        }

        const radios = step.querySelectorAll('input[type="radio"]');
        radios.forEach((radio) => {
          if (!(radio instanceof HTMLInputElement)) {
            return;
          }

          radio.addEventListener('change', () => {
            if (currentStepIndex !== stepIndex) {
              return;
            }

            const isLast = currentStepIndex >= wizardSteps.length - 1;
            if (isLast || !validateCurrentStep()) {
              return;
            }

            window.setTimeout(() => {
              currentStepIndex = Math.min(wizardSteps.length - 1, currentStepIndex + 1);
              refreshWizardUi();
            }, 120);
          });
        });
      });

      if (prevButton instanceof HTMLButtonElement) {
        prevButton.addEventListener('click', () => {
          currentStepIndex = Math.max(0, currentStepIndex - 1);
          refreshWizardUi();
        });
      }

      if (nextButton instanceof HTMLButtonElement) {
        nextButton.addEventListener('click', () => {
          if (!validateCurrentStep()) {
            return;
          }

          currentStepIndex = Math.min(wizardSteps.length - 1, currentStepIndex + 1);
          refreshWizardUi();
        });
      }
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!validateCurrentStep()) {
        return;
      }

      const data = new FormData(form);
      const startedAt = Number(data.get('startedAt') || Date.now());
      const elapsedSeconds = (Date.now() - startedAt) / 1000;
      const honeypot = String(data.get('website') || '');

      if (actif) {
        const qualificationInput = form.elements.namedItem('qualification');
        if (qualificationInput instanceof HTMLInputElement) {
          const answers = [];
          const questionSets = form.querySelectorAll('fieldset[data-field-name]');

          questionSets.forEach((fieldset) => {
            if (!(fieldset instanceof HTMLElement)) {
              return;
            }

            const fieldName = fieldset.dataset.fieldName || '';
            if (!fieldName) {
              return;
            }

            const legend = fieldset.querySelector('legend');
            const checked = form.querySelector(`input[name="${fieldName}"]:checked`);
            if (legend instanceof HTMLElement && checked instanceof HTMLInputElement && checked.value) {
              answers.push({ question: legend.textContent || '', reponse: checked.value });
            }
          });

          qualificationInput.value = JSON.stringify(answers);
          data.set('qualification', qualificationInput.value);
        }
      }

      if (honeypot.trim().length > 0 || elapsedSeconds < 3) {
        messageBox.className = 'error';
        messageBox.textContent = 'Votre demande n\'a pas pu être envoyée. Veuillez réessayer.';
        return;
      }

      if (!form.reportValidity()) {
        return;
      }

      const payload = {
        type: String(data.get('type') || (actif ? 'lead' : 'intention')),
        prenom: String(data.get('prenom') || ''),
        nom: String(data.get('nom') || ''),
        telephone: String(data.get('telephone') || ''),
        email: String(data.get('email') || ''),
        commune: String(data.get('commune') || ''),
        codePostal: String(data.get('codePostal') || ''),
        description: String(data.get('description') || ''),
        delaiSouhaite: String(data.get('delaiSouhaite') || ''),
        budget: String(data.get('budget') || ''),
        qualification: String(data.get('qualification') || ''),
        metier: String(data.get('metier') || ''),
        metier_nom: String(data.get('metier_nom') || ''),
        ville: String(data.get('ville') || ''),
        page_source: String(data.get('page_source') || ''),
        submittedAt: new Date().toISOString()
      };

      // Le jeton Turnstile n'existe que si le widget a pu se charger.
      const turnstileField = form.elements.namedItem('cf-turnstile-response');
      if (turnstileField instanceof HTMLInputElement && turnstileField.value) {
        payload.turnstileToken = turnstileField.value;
      }
      payload.startedAt = startedAt;
      payload.website = honeypot;

      // Chemin unique : /api/lead. Aucun contournement de D1 ni de Turnstile.
      const reactiverEnvoi = () => {
        if (submitButton instanceof HTMLButtonElement) {
          submitButton.disabled = false;
          submitButton.textContent = 'Envoyer ma demande';
        }
      };

      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = true;
        submitButton.textContent = 'Envoi en cours…';
      }

      try {
        const response = await fetch(endpointUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        // Un statut 200 ne suffit pas : pendant la propagation d'un déploiement,
        // certains nœuds servent le HTML du site à la place de la Function.
        // On n'accepte un succès que si la réponse est le JSON attendu.
        let corps = null;
        const typeContenu = response.headers.get('Content-Type') || '';
        if (typeContenu.includes('application/json')) {
          try {
            corps = await response.json();
          } catch (e) {
            corps = null;
          }
        }

        const succes = response.ok && corps && corps.ok === true;

        if (!succes) {
          let detail = corps && corps.erreur ? corps.erreur : '';
          if (!detail && response.ok) {
            detail = 'Le service d\'envoi n\'a pas répondu correctement.';
          }

          // Un jeton anti-robot ne sert qu'une fois : on en redemande un
          // avant de laisser l'utilisateur réessayer.
          if (window.turnstile && typeof window.turnstile.reset === 'function') {
            try { window.turnstile.reset(); } catch (e) {}
          }

          reactiverEnvoi();
          messageBox.className = 'error';
          messageBox.innerHTML = `${detail || 'Votre demande n\'a pas pu être envoyée.'} Vous pouvez réessayer, ou nous joindre au <a href="tel:${telContact.replace(/\s+/g, '')}">${telContact}</a>.`;
          return;
        }

        // Conversion : uniquement après un vrai succès JSON confirmé plus haut
        // (statut 2xx ET corps { ok: true }). `gtag` n'existe qu'après
        // acceptation du bandeau : sans consentement, rien n'est émis.
        //
        // L'événement ne porte que l'origine de la visite. Ni coordonnées, ni
        // description, ni aucune valeur saisie dans le formulaire : GA4 n'a pas
        // à connaître le contenu d'une demande pour en compter une.
        if (typeof window.gtag === 'function') {
          let sourceIA = '';
          try {
            sourceIA = sessionStorage.getItem('source-ia') || '';
          } catch (e) {
            // Stockage indisponible : la conversion partira sans origine.
          }

          window.gtag('event', 'generate_lead', sourceIA ? { source_ia: sourceIA } : {});
        }

        const thankYouUrl = new URL('/merci', window.location.origin);
        thankYouUrl.searchParams.set('type', actif ? 'lead' : 'intention');
        if (payload.metier) {
          thankYouUrl.searchParams.set('metier', payload.metier);
        }
        if (payload.ville) {
          thankYouUrl.searchParams.set('ville', payload.ville);
        }
        window.location.href = thankYouUrl.toString();
        return;
      } catch (error) {
        if (window.turnstile && typeof window.turnstile.reset === 'function') {
          try { window.turnstile.reset(); } catch (e) {}
        }
        reactiverEnvoi();
        messageBox.className = 'error';
        messageBox.innerHTML = `Votre demande n'a pas pu être envoyée. Vérifiez votre connexion et réessayez, ou joignez-nous au <a href="tel:${telContact.replace(/\s+/g, '')}">${telContact}</a>.`;
      }
    });
  }
</script>
